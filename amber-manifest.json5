{
  // Amber manifest for the OfficeQA purple agent.
  //
  // Format follows an ACCEPTED submission to this same leaderboard
  // (Solasticeaistudio/solstice-agentbeats amber-manifest-finance.json5) rather
  // than the generic tutorial: manifest_version 0.1.0, additionalProperties as
  // a literal boolean, a `slots.proxy` a2a slot, and no metadata block.
  //
  // This file is PUBLIC. It carries an image reference, env var NAMES and a
  // port -- no endpoint, no credential, no solver logic. Both config values
  // are secrets supplied at run time by AgentBeats, never committed here.
  manifest_version: "0.1.0",

  config_schema: {
    type: "object",
    properties: {
      officeqa_api_url:   { type: "string", secret: true },
      officeqa_api_token: { type: "string", secret: true },
    },
    required: ["officeqa_api_url", "officeqa_api_token"],
    additionalProperties: false,
  },

  slots: {
    proxy: { kind: "a2a", optional: true },
  },

  program: {
    // PIN A DIGEST, NEVER A TAG.
    //
    // This line used to carry a commit-shaped tag and the claim that "the
    // digest behind this tag cannot change under the run". That claim is
    // false: registry tags are mutable unless the registry separately enforces
    // otherwise, so a rerun could pull different bytes under the same
    // manifest. A commit-shaped tag looks immutable, which made it worse than
    // an obviously-mutable one.
    //
    // After every publish of proxy_agent/, refresh this line with
    //
    //     tools/proxy_image.py pin ghcr.io/onejumpinc/officeqa-proxy-agent:<sha>
    //
    // and `tools/proxy_image.py verify` (run by tools/submit_agentbeats.sh)
    // will confirm the digest was built from the proxy source on disk before
    // anything is submitted.
    image: "ghcr.io/onejumpinc/officeqa-proxy-agent@sha256:67f6a2ef5256f776c636f03ce5f1372402f6c666567bce8a5ae3331621adbd4d",
    entrypoint: "python server.py --host 0.0.0.0 --port 9019",
    env: {
      OFFICEQA_API_URL:   "${config.officeqa_api_url}",
      OFFICEQA_API_TOKEN: "${config.officeqa_api_token}",
      PYTHONUNBUFFERED:   "1",
    },
    network: {
      endpoints: [{ name: "a2a_endpoint", port: 9019 }],
    },
  },

  provides: { a2a: { kind: "a2a", endpoint: "a2a_endpoint" } },
  exports:  { a2a: "a2a" },
}
